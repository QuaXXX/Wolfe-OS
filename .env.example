# Wolfe OS Environment Variables Template
# Copy this file to .env or add these to your Vercel Project Settings > Environment Variables

# Gemini AI API Key
VITE_GEMINI_API_KEY=

# Groq Whisper API Key (Ultra-Fast ~200ms Voice Transcription for iOS PWA)
# Free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Google Calendar & Tasks Integration (Optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REFRESH_TOKEN=
